@@ -37,3 +38,16 @@ export function tick(state: WorldState, input: InputFrame): void {
   // before it decides where to let go (bug-quest.md).
   stepCreature(state);
 }
+
+/**
+ * Is the wizard startled this tick: within CREATURE_STARTLE_TICKS of the tick
+ * the creature climbed on. The startle holds his buttons only. The player step
+ * still runs with an empty frame, so gravity, the water and the props go on
+ * and a startle that begins in the air still lands him (ADR-011,
+ * INC-2026-09-30).
+ */
+export function startled(state: WorldState): boolean {
+  const since = state.creature?.carriedSince ?? -1;
+
+  return since >= 0 && state.tick - since <= CREATURE_STARTLE_TICKS;
+}
