# factory solve N: a deterministic solution of the lesson without a model. Swaps the exercise's files for the version from
# lesson N+1, deploys them to the cluster and prints every step: from where, to where, checksums before and after, every command.
step() { printf '  [%s] %s\n' "$(date +%H:%M:%S)" "$*" >&2; }   # on stderr: redirecting a command's output does not hide the step
run() { step "\$ $*"; "$@"; }
sha() { [ -f "$1" ] || { echo "none"; return; }; { sha256sum "$1" 2>/dev/null || shasum -a 256 "$1"; } | cut -c1-12; }

wait_and_approve() {   # lesson 10: the replay stops at the human; approve as factory-solve and wait for the end
  local w="" i
  for i in $(seq 1 90); do
    w=$(argo list -n "$NS" --running -o name 2>/dev/null | grep -v "^No workflows" | head -1)
    if [ -n "$w" ] && argo get -n "$NS" "$w" -o json 2>/dev/null | python3 -c "import json,sys;d=json.load(sys.stdin);sys.exit(0 if any(n['type']=='Suspend' and n['phase']=='Running' for n in d['status'].get('nodes',{}).values()) else 1)"; then
      step "run $w waits for a human"; run env WHO=factory-solve make -s approve W="$w"; break
    fi
    sleep 10
  done
  [ -n "$w" ] && run argo wait -n "$NS" "$w" >/dev/null
}

cmd_solve() {
  repo; local n; n=$(lesson_no "${1:-}"); tags
  info "factory solve $n: the solution without a model, step by step"
  if [ "$n" = final ]; then
    echo "  The finale opens an issue and a PR on your fork, so I do not do it for you. The steps (lessons/final-github.md):"
    echo "    make github && make issue O=hw-001 && make pull AGENT=replay && gh pr list"
    return 1
  fi
  local files; files=$(exercise_files "$n")
  if [ -n "$files" ]; then
    local next; next=$(lesson_tag $((n + 1))); local p before after tmp
    step "source: tag $next (the final version of exercise $n)"
    for p in $files; do
      before=$(sha "$p"); tmp=$(mktemp); [ -f "$p" ] && cp "$p" "$tmp"
      solution_file "$n" "$p" > "$p" || die "Cannot read the solution of $p"
      after=$(sha "$p")
      if [ "$before" = "$after" ]; then step "unchanged   $p (already the final version)"
      else step "swapped     $p  ← $(solution_source "$n" "$p")  (sha256 $before → $after, $(git diff --no-index --numstat "$tmp" "$p" 2>/dev/null | awk '{print "+"$1" -"$2" lines"}'))"; fi
      rm -f "$tmp"
    done
    ready "$n" >/dev/null && step "reference copy: solutions/$(printf 'lesson-%02d' "$n")/ (files *-f$n)"
    case "$n" in 3|6) run make -s agents-md >/dev/null ;; esac
  fi
  if cluster_exists; then
    context
    case "$n" in
      1) run kubectl apply -f platform/kagent/agent-intake.yaml; run kubectl wait --for=condition=Ready agent/intake -n "$NS" --timeout=180s ;;
      3|4|8) run make -s send >/dev/null ;;
      5) run make -s replay O=hw-001; step "\$ make fetch"; make -s fetch | wc -l | xargs -I{} echo "    fetched files: {} (.sdlc/out/)" ;;
      10) step "\$ make replay O=startle   (in the background; attempt 2 stops at the human)"
          make -s replay O=startle > "${TMPDIR:-/tmp}/factory-solve-10.log" 2>&1 &
          wait_and_approve; wait; tail -2 "${TMPDIR:-/tmp}/factory-solve-10.log" | sed 's/^/    /'
          step "\$ make fetch"; make -s fetch | wc -l | xargs -I{} echo "    fetched files: {} (.sdlc/out/)" ;;
      *) step "\$ factory sync   (make setup, make line, Kyverno, the Argo configuration, the cosign key)"; sync ;;
    esac
  else
    step "no cluster: skipping the deployment (factory start, then factory solve $n again)"
  fi
  [ -n "$files" ] && { step "changes against lesson $n (git diff --stat):"; git --no-pager diff --stat -- $files | sed 's/^/    /'; }
  echo
  cmd_check "$n"
}

