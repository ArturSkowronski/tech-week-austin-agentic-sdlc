# Ready variants of an exercise: files from lesson N+1 as solutions/lesson-NN/<name>-fN.<ext>. A separate directory, because
# e.g. rules-f6.js next to the original would be picked up by the tools. The directory is in .gitignore and .git/info/exclude:
# it never reaches git status or the stash, and the next lesson builds it again.
# The solution file of exercise N: first from the tools (solutions/lesson-NN/<path>), when tag N+1 has more in that file than
# the exercise itself (lesson 9: factory.yaml of lesson 10 already has the ledger step), otherwise from tag N+1.
solution_file() {   # $1: lesson number, $2: path in the repo; prints the content
  local o; o="$DATA/solutions/$(printf 'lesson-%02d' "$1")/$2"
  if [ -f "$o" ]; then cat "$o"; else git show "$(lesson_tag $(($1 + 1))):$2"; fi
}
solution_source() { [ -f "$DATA/solutions/$(printf 'lesson-%02d' "$1")/$2" ] && echo "the tools (a version with exercise $1 only)" || echo "$(lesson_tag $(($1 + 1))):$2"; }

ready() {
  local n=$1 top; top=$(git rev-parse --show-toplevel)
  rm -rf "$top/solutions"
  local ex; ex=$(git rev-parse --git-path info/exclude); mkdir -p "$(dirname "$ex")"
  grep -qx '/solutions/' "$ex" 2>/dev/null || echo '/solutions/' >> "$ex"
  local dir; dir="$top/solutions/$( [ "$n" = final ] && echo final || printf 'lesson-%02d' "$n")"
  local files=""; [ "$n" = final ] || files=$(exercise_files "$n")
  if [ -z "$files" ]; then   # an exercise of commands, not files: the ready variant is a list of commands
    mkdir -p "$dir"
    case "$n" in
      5) printf '%s\n' "# Lesson 5: the line. The solution is a run, not a file." "make replay O=hw-001      # at the end: Result: Succeeded" "make fetch" "factory check 5" ;;
      10) printf '%s\n' "# Lesson 10: the trace and tampering with the ledger." "make replay O=startle   # attempt 2 stops at the human; in a second terminal: make approve W=<run>" "make fetch" "make ledger-verify F=.sdlc/out/startle/attempt-2/ledger.jsonl" "factory check 10" ;;
      *) printf '%s\n' "# Finale: the factory on your fork (lessons/final-github.md)." "make github" "make issue O=hw-001" "make pull AGENT=replay" "gh pr list" "factory check final" ;;
    esac > "$dir/commands-$( [ "$n" = final ] && echo final || echo "f$n").txt"
    echo "solutions/$(basename "$dir")/commands-$( [ "$n" = final ] && echo final || echo "f$n").txt"
    return 0
  fi
  local next; next=$(lesson_tag $((n + 1))); git rev-parse -q --verify "refs/tags/$next" >/dev/null || return 0
  mkdir -p "$dir"
  local p b target
  for p in $files; do
    b=$(basename "$p"); target="${b%.*}-f$n.${b##*.}"
    solution_file "$n" "$p" > "$dir/$target" 2>/dev/null || { rm -f "$dir/$target"; continue; }
    printf '%s  →  %s\n' "$target" "$p" >> "$dir/WHERE.txt"
    echo "solutions/$(printf 'lesson-%02d' "$n")/$target"
  done
}

