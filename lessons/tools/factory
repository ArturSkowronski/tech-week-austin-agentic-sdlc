#!/usr/bin/env bash
# factory: the participant's tools for the workshop "Build a real agentic SDLC platform from scratch".
#
# Installed outside the repo (~/.local/bin/factory, data in ~/.local/share/factory), always from main, so that
# switching the repo to an old lesson does not remove them. Install: make tools (on main) or factory update.
#
#   factory start               kind cluster + everything the current lesson needs, then doctor
#   factory lesson N            the repo and the cluster in the state of lesson N (1-10, final): tag, stash your changes, sync the cluster
#   factory map                 which blocks of the factory work in this repo and cluster
#   factory doctor              the state of the setup: codespace, tools, cluster, agents, the model key, the game, Issues
#   factory check [N]           is the exercise of lesson N done (deterministic, no model)
#   factory autopilot N         run Claude Code with the prompt of lesson N (--prompt: print the prompt only)
#   factory ready [N]           the final files of exercise N in solutions/lesson-NN/*-fN.* (factory lesson makes them too)
#   factory solve N             swap in the final files, deploy, print every step, check; no model
#   factory login               log Claude Code in (then factory callback '<address from the browser>')
#   factory ask AGENT "TASK"     ask an agent in the cluster over A2A (with a model key), e.g. factory ask intake "Add a double jump"
#   factory key                 the model key (sk-ant-… Claude API, sk-or-… OpenRouter, sk-proj-… OpenAI); works on every lesson
#   factory reset               the cluster from scratch (kind delete + start), when the state cannot be saved
#   factory urls                clickable links to the floor (Argo), Jaeger and kagent
#   factory play [fix|<ref>]    play Hobby Wizard in the browser: now (with its bug), with the factory's fix, or any branch
#   factory welcome             the welcome and the first steps (works on every lesson)
#   factory update              fetch the newest tools from main
# No pipefail: the checks are pipes into grep -q, and grep exits on the first hit while the writer gets SIGPIPE.
set -u

UPSTREAM=${FACTORY_UPSTREAM:-https://github.com/ArturSkowronski/tech-week-austin-agentic-sdlc.git}
DATA=${FACTORY_DATA:-$HOME/.local/share/factory}
# The A2A client from main (installed with the tools): the one in an old lesson tag cannot read an agent that asks back.
a2a_py() { [ -f "$DATA/sdlc/a2a.py" ] && echo "$DATA/sdlc/a2a.py" || echo sdlc/a2a.py; }
NS=factory

ok()   { printf '  \033[32m✔\033[0m %s\n' "$*"; }
no()   { printf '  \033[31m✘\033[0m %s\n' "$*"; RED=1; }
skip() { printf '  \033[2m·\033[0m \033[2m%s\033[0m\n' "$*"; }
info() { printf '\033[1m%s\033[0m\n' "$*"; }
die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

CLUSTER=${KIND_CLUSTER:-factory}
HALL_PORT=${HALL_PORT:-2746}
KAGENT_UI_PORT=${KAGENT_UI_PORT:-8082}
JAEGER_PORT=${JAEGER_PORT:-16686}

repo() {
  # The codespace mounts the repo with another owner: git refuses to work, so we allow it.
  if git status --porcelain 2>&1 | grep -q 'dubious ownership'; then
    git config --global --add safe.directory "$(git status 2>&1 | sed -n "s/.*repository at '\(.*\)'.*/\1/p" | head -1)"
  fi
  local top; top=$(git rev-parse --show-toplevel 2>/dev/null) || die "Run it inside the workshop repo (a fork of tech-week-austin-agentic-sdlc)."
  [ -d "$top/system" ] && [ -d "$top/sdlc" ] || die "This does not look like the workshop repo: no system/ and sdlc/."
  cd "$top"
}

# The participant's fork as owner/name, from origin.
fork_name() {
  local f; f=$(git remote get-url origin 2>/dev/null | sed -nE 's#^(https://github\.com/|git@github\.com:)([^/]+/[^/]+)$#\2#p')
  printf '%s' "${f%.git}"
}

# A fork starts with Issues off, and the codespace's token cannot turn them on. Without them the game's "Raise ticket
# on GitHub" and the finale go nowhere, so every factory start, lesson, sync and play says it out loud until it is fixed.
issues_warn() {
  local f s; f=$(fork_name); [ -n "$f" ] || return 0
  s=$(gh api "repos/$f" --jq .has_issues 2>/dev/null) || s=$(curl -fsS -m 5 "https://api.github.com/repos/$f" 2>/dev/null | jq -r .has_issues 2>/dev/null)
  [ "$s" = false ] || return 0
  printf '\n\033[1;33m  ⚠  Issues are OFF on your fork %s\033[0m\n' "$f"
  printf '\033[33m     "Raise ticket on GitHub" in the game and the finale need them. One click, once:\033[0m\n'
  printf '\033[1;33m     https://github.com/%s/settings  →  General  →  Features  →  tick Issues\033[0m\n\n' "$f"
}


lesson_no() {
  case "${1:-}" in
    final|11) echo final ;;
    [1-9]|10|0[1-9]) echo $((10#$1)) ;;
    "") local t; t=$(git describe --tags --match 'lesson-*' --abbrev=0 2>/dev/null); [ -n "$t" ] && echo $((10#${t#lesson-})) || die "Name the lesson." ;;
    *) die "Unknown lesson: $1 (1-10 or final)" ;;
  esac
}
lesson_tag() { [ "$1" = final ] && echo "" || printf 'lesson-%02d' "$1"; }
has_target() { make -n "$1" >/dev/null 2>&1; }
cluster_exists() { command -v kind >/dev/null && kind get clusters 2>/dev/null | grep -qx "$CLUSTER"; }
context() { kubectl config use-context "kind-$CLUSTER" >/dev/null 2>&1; }
k() { kubectl -n "$NS" "$@"; }

# ------------------------------------------------------------------ lesson tags: from the fork, and if the fork has none, from the instructor's repo
tags() {
  git rev-parse -q --verify refs/tags/lesson-10 >/dev/null && return 0
  git fetch -q --tags origin 2>/dev/null || true
  git rev-parse -q --verify refs/tags/lesson-10 >/dev/null && return 0
  echo "The fork has no lesson tags, fetching them from $UPSTREAM"
  git fetch -q "$UPSTREAM" '+refs/tags/lesson-*:refs/tags/lesson-*' || die "Could not fetch the lesson tags."
}

# ------------------------------------------------------------------ the cluster in the state of the current lesson
# The lesson tags carry things fixed later on main, and a fork's tags never change. factory lesson and factory sync
# put the fixes on branch work as one commit, so make a2a, make intake, make floor and the line's images use them:
#   sdlc/a2a.py   the client from main, which reads an agent that asks back (intake: input-required)
#   make floor    factory urls, instead of sourcing workshop.env with sh (dash: "Bad substitution") and localhost links
#   system/vite.config.ts   "Raise ticket on GitHub" on the fork (origin), not on the game's closed upstream repository
tags_fix() {
  local changed=""
  if [ -f "$DATA/system/vite.config.ts" ] && [ -f system/vite.config.ts ] && ! cmp -s "$DATA/system/vite.config.ts" system/vite.config.ts; then
    cp "$DATA/system/vite.config.ts" system/vite.config.ts; changed="$changed system/vite.config.ts"
  fi
  if [ -f "$DATA/sdlc/a2a.py" ] && [ -f sdlc/a2a.py ] && ! cmp -s "$DATA/sdlc/a2a.py" sdlc/a2a.py; then
    cp "$DATA/sdlc/a2a.py" sdlc/a2a.py; changed="$changed sdlc/a2a.py"
  fi
  if grep -q '^	@\. scripts/workshop\.env; open http://localhost' Makefile 2>/dev/null; then
    sed -i.factory 's#^	@\. scripts/workshop\.env; open http://localhost.*#	@factory urls#' Makefile && rm -f Makefile.factory
    changed="$changed Makefile"
  fi
  [ -n "$changed" ] || return 0
  git -c user.name=factory -c user.email=factory@workshop commit -q --no-verify -m "factory: fixes from main ($changed)" -- $changed >/dev/null 2>&1 \
    && echo "Fixes from main on branch work:$changed"
}

# factory key saves the API address and the model (never the key) in $DATA/model.env. cluster.sh of every lesson applies
# the ModelConfig with the defaults (OpenAI), so after it we put back the model the key was tested with.
model_restore() {
  [ -f "$DATA/model.env" ] && [ -f platform/kagent/modelconfig.yaml ] || return 0
  ( . "$DATA/model.env"; LLM_MODEL="$LLM_MODEL" LLM_BASE_URL="$LLM_BASE_URL" envsubst < platform/kagent/modelconfig.yaml | kubectl apply -f - >/dev/null 2>&1 ) || true
}

sync() {
  cluster_exists || die "No kind cluster \"$CLUSTER\". First: factory start"
  context
  tags_fix
  model_restore
  if has_target setup; then
    info "Cluster: make setup (images, workshop, agents, line; a few minutes the first time)"
    make -s setup || die "make setup failed. Show this log to the instructor or try: factory reset"
  else
    info "Lesson 1: the cluster has only the agent \"probe\" (no tools). The MCP server \"workshop\" and the builder agent come in lesson 2."
  fi
  if has_target line; then make -s line >/dev/null || true; fi
  # The Argo controller configuration (lesson 5) and the run traces (lesson 10) live in cluster.sh, which sync does not call:
  # we add them here, so a cluster started on lesson 1 catches up with the later lessons.
  [ -f platform/argo/controller-configmap.yaml ] && JAEGER_PORT=$JAEGER_PORT envsubst '${JAEGER_PORT}' < platform/argo/controller-configmap.yaml | kubectl apply --server-side --force-conflicts -f - >/dev/null 2>&1 || true
  kubectl -n argo get deploy workflow-controller >/dev/null 2>&1 && kubectl -n argo set env deploy/workflow-controller \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger.factory.svc:4317 OTEL_EXPORTER_OTLP_INSECURE=true OTEL_SERVICE_NAME=argo-workflows >/dev/null 2>&1 || true
  # The ledger key is your cluster's, and checking out a lesson restores the instructor's cosign.pub: rebuild it from the key.
  local kdir=platform/line/cosign
  if [ -f "$kdir/cosign.key" ] && git ls-files --error-unmatch "$kdir/cosign.pub" >/dev/null 2>&1 && command -v cosign >/dev/null; then
    COSIGN_PASSWORD="" cosign public-key --key "$kdir/cosign.key" > "$kdir/cosign.pub.tmp" 2>/dev/null && mv "$kdir/cosign.pub.tmp" "$kdir/cosign.pub" || rm -f "$kdir/cosign.pub.tmp"
  fi
  [ -f platform/kyverno/agent-tools.yaml ] && kubectl apply -f platform/kyverno/agent-tools.yaml >/dev/null 2>&1 || true
  if [ -f platform/kagent/agent-intake.yaml ] && ! grep -qE '^[[:space:]]+TODO[[:space:]]*$' platform/kagent/agent-intake.yaml; then
    kubectl apply -f platform/kagent/agent-intake.yaml >/dev/null 2>&1 || true
  fi
}

preflight() {
  [ "${FACTORY_NO_PREFLIGHT:-0}" = 1 ] && return 0
  command -v docker >/dev/null && docker info >/dev/null 2>&1 || die "Docker does not run yet: wait until the codespace finishes starting, then factory start again."
  local mem; mem=$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)
  [ "$mem" -ge 7000000000 ] 2>/dev/null || die "Docker has $((mem / 1024 / 1024 / 1024)) GB of memory, the factory needs at least 8 GB. Create the codespace on the 4-core machine (16 GB)."
  local root; root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null); [ -d "$root" ] || root=$HOME
  local free; free=$(df -Pk "$root" 2>/dev/null | awk 'NR==2 {print int($4/1024/1024)}')
  # Right after a codespace starts, Docker reports too little space: read it again, and only warn.
  [ "${free:-0}" -ge 10 ] || { sleep 15; free=$(df -Pk "$root" 2>/dev/null | awk 'NR==2 {print int($4/1024/1024)}'); }
  [ "${free:-0}" -ge 10 ] || echo "Warning: Docker has ${free} GB free, the factory needs about 10 GB. If start fails: docker system prune."
  for t in kind kubectl helm make git python3 node pnpm jq envsubst; do command -v "$t" >/dev/null || die "No $t: the codespace did not finish its setup. Rebuild it: Ctrl+Shift+P → Codespaces: Rebuild Container"; done
}

cmd_start() {
  repo
  preflight
  info "kind cluster \"$CLUSTER\" (5-10 minutes the first time)"
  # cluster.sh is idempotent: on a slower machine pods come up after the timeout, and a second pass finds them.
  make -s cluster || { info "The cluster comes up slower than usual, trying again"; make -s cluster; } || die "make cluster failed twice. factory reset, or show the log to the instructor."
  sync
  make -s doctor || true
  cmd_urls
  info "Done. Next: open the floor (link above), factory map, then factory lesson 1 (or any number)."
  issues_warn
}

cmd_lesson() {
  repo; local n; n=$(lesson_no "${1:-}"); tags
  local target; if [ "$n" = final ]; then git fetch -q origin main 2>/dev/null || git fetch -q "$UPSTREAM" main; target=FETCH_HEAD; else target=$(lesson_tag "$n"); fi
  # A run in progress works on the shared /work disk: switching the lesson would overwrite its repo.
  if cluster_exists && context && [ -n "$(k get workflows --field-selector status.phase=Running -o name 2>/dev/null)" ]; then
    echo "Stopping runs in progress (shared /work disk): argo stop"
    argo stop -n "$NS" --all >/dev/null 2>&1 || k delete workflows --field-selector status.phase=Running >/dev/null 2>&1 || true
  fi
  if [ -n "$(git status --porcelain)" ]; then
    git stash push -q -u -m "factory: before lesson $n" && echo "Your changes are in git stash (git stash list)."
  fi
  git switch -q -C work "$target" || die "Could not switch to $target."
  tags_fix
  date -u +%Y-%m-%dT%H:%M:%SZ > "$(git rev-parse --git-dir)/factory-lesson"   # runs of this lesson count from now
  echo "Branch work = $( [ "$n" = final ] && echo 'main (finale)' || echo "$target" )"
  cluster_exists && sync || echo "No cluster yet: factory start"
  echo
  local mat; mat=$(ls lessons/ 2>/dev/null | grep -E "^lesson-$(printf %02d "${n/final/11}")|^final" | head -1)
  info "Lesson $n ready."
  echo "  material:   lessons/${mat:-final-github.md}"
  echo "              the newest version: ${UPSTREAM%.git}/blob/main/lessons/${mat:-final-github.md}"
  echo "  exercise:   factory autopilot $n  (runs Claude Code; inside Claude Code: /factory-autopilot $n)"
  echo "  check:      factory check $n"
  local g; g=$(ready "$n")
  if [ -n "$g" ]; then
    echo "  ready variant (the final version of the exercise, to look at or copy):"
    echo "$g" | sed 's/^/    /'
    case "$g" in *commands-f*) ;; *) echo "    swap it in with one command: factory solve $n (prints every step)" ;; esac
  fi
  issues_warn
}

cmd_reset() {
  repo
  info "Deleting the kind cluster \"$CLUSTER\" and building it from scratch"
  kind delete cluster --name "$CLUSTER" >/dev/null 2>&1 || true
  cmd_start
}

# ------------------------------------------------------------------ the map of blocks
cmd_map() {
  repo; local up=0; cluster_exists && context && up=1
  local tag; tag=$(git describe --tags --match 'lesson-*' 2>/dev/null || echo "?")
  info "The factory in this repo: $tag, branch $(git branch --show-current)"
  local wt=""; [ $up = 1 ] && wt=$(k get workflowtemplate factory -o json 2>/dev/null)
  block() { # $1 lesson, $2 name, $3 condition (0 = present)
    if [ "$3" = 0 ]; then ok "L$1  $2"; else skip "L$1  $2"; fi
  }
  t() { eval "$1" >/dev/null 2>&1 && echo 0 || echo 1; }
  [ $up = 1 ] || echo "  (no cluster: factory start; showing the repo only)"
  block 1  "an agent as a resource (Agent probe, A2A)"                "$(t "[ $up = 1 ] && k get agent probe")"
  block 1  "the intake agent with an instruction"                     "$(t "[ -f platform/kagent/agent-intake.yaml ] && ! grep -qE '^[[:space:]]+TODO[[:space:]]*$' platform/kagent/agent-intake.yaml")"
  block 2  "workshop: the MCP server, five tools"                     "$(t "[ $up = 1 ] && k get mcpserver workshop")"
  block 2  "the wall: PROTECTED_PATHS in the server"                  "$(t "[ $up = 1 ] && k get mcpserver workshop -o jsonpath='{.spec.deployment.env.PROTECTED_PATHS}' | grep -q sdlc")"
  block 3  "context L1-L5: AGENTS.md and routing"                     "$(t "[ -f sdlc/context.py ] && [ -f AGENTS.md ]")"
  block 3  "concept ownership: owns in game/sim"                      "$(t "python3 -c \"import json,sys;sys.exit(0 if json.load(open('system/game/sim/module.json')).get('owns') else 1)\"")"
  block 4  "intake: criteria before the agent"                        "$(t "[ -f sdlc/intake.py ]")"
  block 4  "double jump with criteria"                                "$(t "grep -qi '^criteria' orders/double-jump.md")"
  block 5  "the line in Argo (WorkflowTemplate factory)"              "$(t "[ -n \"\$wt\" ]")"
  block 6  "gates: quality control in the line"                       "$(t "echo \"\$wt\" | grep -q '\"name\": *\"quality\"'")"
  block 6  "the architecture rule: game/sim is deterministic"         "$(t "grep -q 'sim_is_deterministic' system/architecture/rules.js && ! grep -q 'TODO(lesson 6)' system/architecture/rules.js")"
  block 7  "the oracle in the line"                                   "$(t "echo \"\$wt\" | grep -q '\"name\": *\"oracle\"'")"
  block 7  "the wall: scenarios/ hidden (HIDDEN_PATHS)"               "$(t "[ $up = 1 ] && k get mcpserver workshop -o jsonpath='{.spec.deployment.env.HIDDEN_PATHS}' | grep -q scenarios")"
  block 8  "risk and review in the line"                              "$(t "echo \"\$wt\" | grep -q '\"name\": *\"review\"'")"
  block 8  "the review rule: hold the input, not the physics"         "$(t "python3 -c \"import json;r=[x for x in json.load(open('sdlc/review-rules.json'))['rules'] if x['kind']=='llm' and 'gravity' in (x.get('rule','')+x.get('pass','')+x.get('fail','')).lower()];assert r\"")"
  block 9  "human: suspend in the line"                               "$(t "echo \"\$wt\" | grep -q '\"suspend\"'")"
  block 9  "Kyverno policy: the builder has only the workshop"        "$(t "[ -f platform/kyverno/agent-tools.yaml ] && ! grep -q 'expression: \"true\"' platform/kyverno/agent-tools.yaml")"
  block 10 "the ledger and the cosign signature"                      "$(t "echo \"\$wt\" | grep -q '\"name\": *\"ledger\"' && [ $up = 1 ] && k get secret factory-cosign")"
  block 10 "trace: Argo sends traces to Jaeger"                       "$(t "[ $up = 1 ] && kubectl -n argo get deploy workflow-controller -o jsonpath='{.spec.template.spec.containers[0].env}' | grep -q OTEL")"
  block F  "GitHub: the issue poller and PRs (make github)"           "$(t "[ $up = 1 ] && k get cronworkflow factory-pull")"
}

# ------------------------------------------------------------------ checking the exercise
workshop_py() { # a Workspace call inside the MCP server's pod, without writing events to the ledger
  k exec deploy/workshop -- python3 -c "
import sys; sys.path.insert(0, '/app')
from workspace import Workspace
ws = Workspace.from_env(); ws.events_file = None
try:
    print($1)
except Exception as e:
    print('Rejected:', e)
" 2>/dev/null
}

check_1() {
  local f=platform/kagent/agent-intake.yaml
  # TODO in the systemMessage field itself (the comments in the header also say "TODO" and do not count)
  grep -qE '^[[:space:]]+TODO[[:space:]]*$' "$f" && no "$f: the systemMessage still says TODO" || ok "the intake agent's instruction is written"
  # The agent "intake" is in the cluster from the start (with TODO, or an older text), so Ready alone proves nothing:
  # the instruction in the cluster has to be the one in the file, i.e. it was sent with kubectl apply.
  local mine theirs
  mine=$(kubectl create --dry-run=client -f "$f" -o jsonpath='{.spec.declarative.systemMessage}' 2>/dev/null)
  theirs=$(k get agent intake -o jsonpath='{.spec.declarative.systemMessage}' 2>/dev/null)
  [ -n "$mine" ] && [ "$mine" = "$theirs" ] && ok "the cluster has the instruction from $f" \
    || { no "the cluster still has a different instruction than $f: kubectl apply -f $f"; return; }
  k get agent intake -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null | grep -q True \
    && ok "the intake agent is deployed and Ready" || { no "the intake agent is not Ready: kubectl wait --for=condition=Ready agent/intake -n $NS --timeout=180s"; return; }
  local key; key=$(k get secret factory-llm -o jsonpath='{.data.LLM_API_KEY}' 2>/dev/null | base64 -d 2>/dev/null)
  if [ -z "$key" ] || [ "$key" = none ]; then skip "the agent's answer: skipped, no model key (factory key)"; return; fi
  k rollout status deploy/intake --timeout=120s >/dev/null 2>&1   # an agent's Ready is not its pod yet: without this A2A gets connection refused
  local out; out=$(python3 "$(a2a_py)" --agent intake --task "Double jump. Players keep asking for a second jump in the air. Add it." 2>&1)
  # A model that is unavailable (limits, no credit, network) is not an exercise error: the instruction and the deployment are checked above.
  if [ $? -ne 0 ] || printf '%s' "$out" | grep -qiE 'A2A (error|HTTP)|429|credit|quota|rate limit|returned no text'; then
    local why; why=$(printf '%s' "$out" | grep -oiE '429|credit[a-z_]*|quota|rate limit|HTTP [0-9]+|connection refused' | head -1)
    skip "the agent's answer: the model does not answer (${why:-$(printf '%s' "$out" | tail -1 | cut -c1-70)}), check later"; return
  fi
  local n; n=$(printf '%s\n' "$out" | grep -cE '^\s*([-*•]|[0-9]+\.)\s')
  [ "$n" -ge 2 ] && [ "$n" -le 6 ] && ok "the agent answers with a list of $n questions" || no "the agent does not answer with a list of 2-6 questions (I see $n points)"
}
check_2() {
  k get mcpserver workshop -o jsonpath='{.spec.deployment.env.PROTECTED_PATHS}' | grep -q sdlc && ok "PROTECTED_PATHS deployed in the server" || no "in the cluster PROTECTED_PATHS has no sdlc (kubectl apply -f platform/workshop/mcpserver.yaml)"
  local p; for p in sdlc/policy.json platform/kind.yaml system/architecture/rules.js; do
    workshop_py "ws.write_file('$p.factory-check', 'x')" | grep -q '^Rejected' && ok "a write to $p rejected by the server" \
      || { no "the server accepted a write to $p"; k exec deploy/workshop -- rm -f "/work/repo/$p.factory-check" 2>/dev/null; }
  done
}
check_3() {
  local m; m=$(python3 sdlc/context.py route --title "$(python3 sdlc/orders.py hw-001 --title)" --body "$(python3 sdlc/orders.py hw-001 --body)" 2>/dev/null | grep -oE 'goes to `[a-z-]+`' | head -1 | tr -d '`' | sed 's/goes to //')
  echo "$m" | grep -qx sim && ok "routing: HW-001 goes to sim" || no "routing points to ${m:-?}: fill in owns in system/game/sim/module.json"
  python3 -c "import sys; sys.path.insert(0, 'sdlc'); import context; sys.stdout.write(context.agents_md(context.build_index()))" 2>/dev/null | cmp -s - AGENTS.md \
    && ok "AGENTS.md is up to date with its sources" || no "AGENTS.md is stale or missing: make agents-md"
}
check_4() {
  grep -qiE '^\s*(#+\s*)?criteria' orders/double-jump.md && ok "double-jump has a Criteria section" || no "orders/double-jump.md has no Criteria: section"
  local t b; t=$(python3 sdlc/orders.py double-jump --title); b=$(python3 sdlc/orders.py double-jump --body)
  python3 sdlc/context.py route --title "$t" --body "$b" >/dev/null 2>&1
  python3 sdlc/intake.py --title "$t" --body "$b" >/dev/null 2>&1
  python3 -c "import json,sys;sys.exit(0 if json.load(open('.sdlc/intake.json'))['accepted'] else 1)" 2>/dev/null \
    && ok "intake: the work order is accepted" || no "intake still sends double-jump back (make intake O=double-jump shows why)"
}
check_5() {
  k get workflowtemplate factory >/dev/null 2>&1 && ok "the line is deployed" || no "no line: make line"
  # Only runs since switching to the lesson count: old ones, from other lessons, are no proof.
  local since; since=$(cat "$(git rev-parse --git-dir)/factory-lesson" 2>/dev/null || echo 1970-01-01T00:00:00Z)
  local s; s=$(k get workflows -o json 2>/dev/null | SINCE="$since" python3 -c "
import json,os,sys
d=json.load(sys.stdin)['items']
ok=[w for w in d if any(p.get('name')=='order' and p.get('value')=='hw-001' for p in w['spec'].get('arguments',{}).get('parameters',[]))
    and w.get('status',{}).get('phase')=='Succeeded' and w['metadata']['creationTimestamp']>=os.environ['SINCE']]
print(len(ok))")
  [ "${s:-0}" -ge 1 ] && ok "HW-001 went through the line ($s run(s))" || no "no successful run of HW-001: make replay O=hw-001"
  # make fetch keeps the times of the files in the cluster: only a patch made since the switch to the lesson counts.
  make -s fetch >/dev/null 2>&1
