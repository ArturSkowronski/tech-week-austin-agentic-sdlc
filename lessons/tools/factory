  context; ok "kind cluster $CLUSTER"
  local a st
  for a in $(k get agent -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do
    st=$(k get agent "$a" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)
