diff --git a/system/tests/sim/startle.test.ts b/system/tests/sim/startle.test.ts
new file mode 100644
index 0000000..b3d1618
--- /dev/null
+++ b/system/tests/sim/startle.test.ts
@@ -0,0 +1,47 @@
+// The startle (orders/startle.md): for CREATURE_STARTLE_TICKS after the
+// creature climbs on, the wizard does not answer his buttons.
+
+import { describe, expect, it } from 'vitest';
+
+import { CREATURE_STARTLE_TICKS, NO_INPUT, tick } from '../../game/sim/index';
+import type { InputFrame, WorldState } from '../../game/sim/index';
+import { hold, run, worldFrom } from './helpers';
+
+const ROOM = `
+
+  P  B
+  #################
+`;
+
+const RIGHT: InputFrame = { ...NO_INPUT, right: true };
+
+function mount(world: WorldState): number {
+  for (let step = 0; step < 1000 && (world.creature?.carriedSince ?? -1) < 0; step += 1) {
+    tick(world, RIGHT);
+  }
+
+  return world.creature?.carriedSince ?? -1;
+}
+
+describe('the startle', () => {
+  it('ignores the buttons right after the creature climbs on', () => {
+    const world = worldFrom(ROOM, { creature: true });
+    const since = mount(world);
+    const x = world.player.x;
+
+    run(world, hold({ right: true, jump: true }, CREATURE_STARTLE_TICKS - (world.tick - since)));
+
+    expect(world.player.x).toBe(x);
+    expect(world.player.onGround).toBe(true);
+  });
+
+  it('answers the buttons once the startle is over', () => {
+    const world = worldFrom(ROOM, { creature: true });
+
+    mount(world);
+    run(world, hold({}, CREATURE_STARTLE_TICKS));
+    run(world, hold({ jump: true }, 1));
+
+    expect(world.player.onGround).toBe(false);
+  });
+});
