# Values for the day of the workshop, in the codespace. Each can be overridden by an environment variable.
# The model key LLM_API_KEY you get in the room (or bring your own): factory key. It is never kept in the repo.
KIND_CLUSTER=${KIND_CLUSTER:-factory}
# Host ports of the cluster (platform/kind.yaml), forwarded by Codespaces (.devcontainer/devcontainer.json).
HALL_PORT=${HALL_PORT:-2746}
KAGENT_API_PORT=${KAGENT_API_PORT:-8083}
KAGENT_UI_PORT=${KAGENT_UI_PORT:-8082}
JAEGER_PORT=${JAEGER_PORT:-16686}
# The model through an OpenAI-compatible API. factory key picks the API from the kind of key (sk-ant, sk-or, sk-proj).
LLM_BASE_URL=${LLM_BASE_URL:-https://api.openai.com/v1}
LLM_MODEL=${LLM_MODEL:-gpt-5.4}
# Images built locally and loaded into kind (make setup).
IMAGE_TAG=${IMAGE_TAG:-lesson}
export KIND_CLUSTER HALL_PORT KAGENT_API_PORT KAGENT_UI_PORT JAEGER_PORT LLM_BASE_URL LLM_MODEL IMAGE_TAG
