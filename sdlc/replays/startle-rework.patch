index 0000000..95cc580
--- /dev/null
+++ b/system/tests/sim/startle.test.ts
@@ -0,0 +1,94 @@
+// The startle (orders/startle.md): for CREATURE_STARTLE_TICKS after the
+// creature climbs on, the wizard's buttons do nothing, and the world goes on.
+// Nothing here asks which way left and right go while it rides; that is
+// HW-001's paired test alone (AGENTS.md rule 5).
+
+import { describe, expect, it } from 'vitest';
+
+import { CREATURE_STARTLE_TICKS, NO_INPUT, tick } from '../../game/sim/index';
+import type { InputFrame, WorldState } from '../../game/sim/index';
+import { hold, run, worldFrom } from './helpers';
+
+/** Floor the whole way and a bush to walk into. */
+const ROOM = `
+
+  P  B
+  #################
+`;
+
+/** A ledge, then a bush hanging over the drop, then the floor far below. */
+const DROP = `
+  P
+  ###
+       B
+
+
+
+  ##################
+`;
+
+const RIGHT: InputFrame = { ...NO_INPUT, right: true };
+const JUMP: InputFrame = { ...NO_INPUT, jump: true };
+
+/** Ticks a stepping loop tries before calling it a failure rather than hanging. */
+const GIVE_UP = 1000;
+
+/** Walk right until the creature is on the hat; the tick it climbed on is `carriedSince`. */
+function mount(world: WorldState): number {
+  for (let step = 0; step < GIVE_UP && (world.creature?.carriedSince ?? -1) < 0; step += 1) {
+    tick(world, RIGHT);
+  }
+
+  const since = world.creature?.carriedSince ?? -1;
+
+  expect(since, 'the creature never climbed on').toBeGreaterThanOrEqual(0);
+
+  return since;
+}
+
+describe('the startle', () => {
+  it('ignores a jump pressed on the last startled tick', () => {
+    const world = worldFrom(ROOM, { creature: true });
+    const since = mount(world);
+
+    run(world, hold({}, since + CREATURE_STARTLE_TICKS - 1 - world.tick));
+    run(world, [JUMP]);
+
+    expect(world.tick - since).toBe(CREATURE_STARTLE_TICKS);
+    expect(world.player.onGround).toBe(true);
+  });
+
+  it('gives the buttons back on the tick after it', () => {
+    const world = worldFrom(ROOM, { creature: true });
+    const since = mount(world);
+
+    run(world, hold({}, since + CREATURE_STARTLE_TICKS - world.tick));
+    run(world, [JUMP]);
+
+    expect(world.tick - since).toBe(CREATURE_STARTLE_TICKS + 1);
+    expect(world.player.onGround).toBe(false);
+    expect(world.player.state).toBe('jump');
+  });
+
+  it('holds the buttons, not the fall, when it begins in the air', () => {
+    const world = worldFrom(DROP, { creature: true });
+    const since = mount(world);
+
+    expect(world.player.onGround, 'it climbed on before he left the ledge').toBe(false);
+
+    const y = world.player.y;
+
+    run(world, hold({}, CREATURE_STARTLE_TICKS - 1));
+
+    expect(world.tick - since).toBeLessThanOrEqual(CREATURE_STARTLE_TICKS);
+    expect(world.player.y).toBeGreaterThan(y);
+  });
+
+  it('replays: the same frames are startled on the same ticks', () => {
+    const frames = [...hold({ right: true }, 40), ...hold({ jump: true }, 30), ...hold({ right: true }, 30)];
+    const a = run(worldFrom(ROOM, { creature: true, seed: 3 }), frames);
+    const b = run(worldFrom(ROOM, { creature: true, seed: 3 }), frames);
+
+    expect(a).toEqual(b);
+  });
+});
