# Play Hobby Wizard in the browser. Before the lessons: the game with its planted bug. After a fix: the same game with it.
#   factory play                the game as your repo has it now, port 5173 (main keeps bug HW-001); the codespace starts it for you
#   factory play fix [order]    your repo plus the newest patch the factory fetched (make fetch), default hw-001, port 5174
#   factory play <git ref>      any branch or commit, e.g. agent/issue-3 after the finale, port 5174
# A fix or a ref is played from a separate copy ($DATA/play), so your working tree stays as it is.
cmd_play() {
  repo
  local what=${1:-} port=${FACTORY_PLAY_PORT:-5174} dir="$DATA/play" label patch order ref
  case "$what" in
    ""|now) dir="$PWD"; port=${FACTORY_PLAY_PORT:-5173}; label="your repo as it is now (it reloads when the files change)" ;;
    fix)
      order=${2:-hw-001}
      patch=$(ls -t .sdlc/out/"$order"/attempt-*/change.patch 2>/dev/null | head -1)
      [ -n "$patch" ] || die "No fetched patch for $order. Run the work order and fetch it first: make replay O=$order && make fetch"
      ref=HEAD; label="your repo + the factory's fix from $patch" ;;
    *)
      git rev-parse -q --verify "$what^{commit}" >/dev/null 2>&1 || git fetch -q origin "$what:refs/remotes/origin/$what" 2>/dev/null
      if git rev-parse -q --verify "$what^{commit}" >/dev/null 2>&1; then ref=$what
      elif git rev-parse -q --verify "origin/$what^{commit}" >/dev/null 2>&1; then ref=origin/$what
      else die "No branch or commit called $what. After the finale: git fetch origin, then factory play agent/issue-<N>"; fi
      label="$ref" ;;
  esac
  if [ "$dir" != "$PWD" ]; then
    git worktree remove --force "$dir" >/dev/null 2>&1; rm -rf "$dir"; git worktree prune
    git worktree add -q --detach "$dir" "$ref" || die "Could not check out $ref."
    if [ -n "${patch:-}" ]; then git -C "$dir" apply "$PWD/$patch" || die "The patch does not apply on your current commit: $patch"; fi
    [ -d system/node_modules ] || (cd system && pnpm install --frozen-lockfile) || die "pnpm install failed in system/."
    ln -s "$PWD/system/node_modules" "$dir/system/node_modules"
  else
    [ -d system/node_modules ] || (cd system && pnpm install --frozen-lockfile) || die "pnpm install failed in system/."
  fi
  # The binaries straight from node_modules/.bin, not pnpm run: in the copy node_modules is a link to your repo's, and
  # pnpm's check before run tries to reinstall it there and refuses (ERR_PNPM_UNSAFE_MODULES_DIR).
  local log="${TMPDIR:-/tmp}/factory-play-assets.log" assets
  assets=$(cd "$dir/system" && node -p 'require("./package.json").scripts.assets')
  (cd "$dir/system" && PATH="$PWD/node_modules/.bin:$PATH" sh -c "$assets" >"$log" 2>&1) \
    || { tail -5 "$log" >&2; die "Building the game's assets failed (log: $log)."; }
  # "Raise ticket on GitHub" (T) opens a prefilled issue: on your fork, not on the game's own repository.
  local fork; fork=$(fork_name)
  echo
  echo "  🎮 Hobby Wizard: $label"
  echo "     $(url "$port" /)"
  echo
  echo "  Keys: arrows walk, Z jumps, X charges, T raises a ticket. HW-001: walk through the bush on the plateau, hold right."
  [ -n "$fork" ] && echo "  T and \"Raise ticket on GitHub\" open an issue on your fork: https://github.com/$fork/issues"
  issues_warn
  echo "  Ctrl+C stops the game."
  echo
  cd "$dir/system" && __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=.app.github.dev,.github.dev exec ./node_modules/.bin/vite --host 0.0.0.0 --port "$port" --strictPort --clearScreen false
}

