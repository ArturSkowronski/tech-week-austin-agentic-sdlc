  if [ -f "$f" ] && ! grep -qE '^[[:space:]]+TODO[[:space:]]*$' "$f"; then
    mine=$(kubectl create --dry-run=client -f "$f" -o jsonpath='{.spec.declarative.systemMessage}' 2>/dev/null)
    theirs=$(k get agent intake -o jsonpath='{.spec.declarative.systemMessage}' 2>/dev/null)
    [ -n "$mine" ] && [ "$mine" = "$theirs" ] && ok "intake runs the instruction from $f" || no "intake in the cluster differs from $f: kubectl apply -f $f"
  else
    skip "intake: the instruction in $f is still TODO (lesson 1)"
  fi

  info "Model key"
  local key url model kind want
  key=$(k get secret factory-llm -o jsonpath='{.data.LLM_API_KEY}' 2>/dev/null | base64 -d 2>/dev/null)
  url=$(k get modelconfig factory-model -o jsonpath='{.spec.openAI.baseUrl}' 2>/dev/null)
  model=$(k get modelconfig factory-model -o jsonpath='{.spec.model}' 2>/dev/null)
  if [ -z "$key" ] || [ "$key" = none ]; then
    skip "no key: replay mode, every lesson passes without a model (factory key to add one)"
  else
    case "$key" in
      sk-ant-*) kind="Claude API"; want=api.anthropic.com ;;
      sk-or-*)  kind=OpenRouter;   want=openrouter.ai ;;
      sk-*)     kind=OpenAI;       want=api.openai.com ;;
      *)        kind="another API"; want="" ;;
    esac
    ok "key: $kind (${key:0:7}…), model $model at $url"
    case "$url" in *"$want"*) ;; *) no "the key is for $kind, the model goes to $url: factory key again" ;; esac
    # The agents read the key when their pod starts: a pod older than the key still has the old one.
    local since old; since=$(k get secret factory-llm -o jsonpath='{.metadata.managedFields[*].time}' 2>/dev/null | tr ' ' '\n' | sort | tail -1)
    old=$(k get pods -l app=kagent -o jsonpath='{range .items[*]}{.status.startTime} {.metadata.labels.kagent}{"\n"}{end}' 2>/dev/null \
      | awk -v s="$since" '$1 < s {print $2}' | sort -u | tr '\n' ' ')
    [ -z "$old" ] && ok "every agent started after the key was set" || no "these agents still have the old key: ${old}(factory key again, or kubectl rollout restart deploy -n $NS -l app=kagent)"
    local out; out=$(timeout 90 python3 "$(a2a_py)" --agent probe --task "Answer with one word: ok" 2>&1)
    if [ $? -eq 0 ]; then ok "the model answers (agent probe: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-40))"
    else no "the model does not answer: $(printf '%s' "$out" | tail -1 | cut -c1-110)"; fi
  fi

  info "Game and GitHub"
  curl -fsS -m 3 -o /dev/null http://localhost:5173/ 2>/dev/null && ok "the game runs on port 5173" || no "the game does not run: factory play (in a separate terminal)"
  if [ -n "$fork" ] && command -v gh >/dev/null; then
    case "$(gh api "repos/$fork" --jq .has_issues 2>/dev/null)" in
      true)  ok "Issues on the fork are on (Raise ticket on GitHub works)" ;;
      false) no "Issues on the fork are off: https://github.com/$fork/settings → Features → Issues" ;;
      *)     skip "could not read the fork's settings (gh)" ;;
    esac
  fi
  env -u GITHUB_TOKEN gh auth status >/dev/null 2>&1 && ok "gh logged in with your account (finale)" \
    || skip "gh with your own account: needed only in the finale (env -u GITHUB_TOKEN gh auth login -h github.com -s repo,workflow)"
  echo; [ $RED = 0 ] && info "factory doctor: green." || { info "factory doctor: red. Run what the red lines say."; return 1; }
}

# Ask an agent over A2A with the client from the tools, on any lesson.
cmd_ask() {
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || die "factory ask AGENT \"TASK\", e.g. factory ask intake \"Double jump. Players keep asking for a second jump in the air. Add it.\""
  repo; cluster_exists || die "No cluster: factory start"; context
  python3 "$(a2a_py)" --agent "$1" --task "$2"
}

# The model key: the script from the tools (from main), so every lesson tag uses the same, newest version.
cmd_key() {
  repo; [ -f "$DATA/key.sh" ] || die "No key script in the tools. Run: factory update"
  cluster_exists || die "The key goes into the cluster, and there is no cluster yet: factory start first."
  context
  FACTORY_REPO=$PWD FACTORY_MODEL_ENV="$DATA/model.env" bash "$DATA/key.sh"
}

cmd_update() {
  # Always from the instructor's repo: origin is the participant's fork, and a fork does not get new commits by itself.
  local tmp files="lessons/tools scripts/key.sh sdlc/a2a.py sdlc/tracing.py sdlc/lib.py system/vite.config.ts .devcontainer/welcome.txt"
  tmp=$(mktemp -d)
  git -C "$tmp" init -q && git -C "$tmp" fetch -q --depth 1 "$UPSTREAM" main && git -C "$tmp" archive FETCH_HEAD $files | tar -x -C "$tmp" \
    || die "Could not fetch the tools from $UPSTREAM."
  bash "$tmp/lessons/tools/install.sh"; rm -rf "$tmp"
  echo "Tools from $UPSTREAM ($(date +%H:%M)). Open a new terminal for Tab completion."
}

help() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-help}" in
  start) cmd_start ;;
  lesson) cmd_lesson "${2:-}" ;;
  map) cmd_map ;;
  check) cmd_check "${2:-}" ;;
  autopilot) cmd_autopilot "${2:-}" "${3:-}" ;;
  ready) cmd_ready "${2:-}" ;;
  solve) cmd_solve "${2:-}" ;;
  login) cmd_login ;;
  callback) cmd_callback "${2:-}" ;;
  reset) cmd_reset ;;
  urls) cmd_urls ;;
  play) cmd_play "${2:-}" "${3:-}" ;;
  welcome) cmd_welcome ;;
  key) cmd_key ;;
  ask) cmd_ask "${2:-}" "${3:-}" ;;
  doctor) cmd_doctor ;;
  update) cmd_update ;;
  sync) repo; issues_warn; sync ;;
  *) help ;;
esac
