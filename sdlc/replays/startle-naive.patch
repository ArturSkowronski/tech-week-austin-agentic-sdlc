index 0000000..b99aaaa
--- /dev/null
+++ b/system/tests/sim/startle.test.ts
@@ -0,0 +1,61 @@
+// The startle (orders/startle.md): for a moment after the creature climbs on,
+// the wizard's buttons do nothing; then he plays on.
+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { CREATURE_STARTLE_TICKS, NO_INPUT, tick } from '../../game/sim/index';
+import type { InputFrame, WorldState } from '../../game/sim/index';
+import { hold, run, worldFrom } from './helpers';
+
+const ROOM = `
+
+  P  B
+  #################
+`;
+
+const RIGHT: InputFrame = { ...NO_INPUT, right: true };
+
+/** Walk right until the creature is on the hat; returns the tick it climbed on. */
+function mount(world: WorldState): number {
+  for (let step = 0; step < 1000 && (world.creature?.carriedSince ?? -1) < 0; step += 1) {
+    tick(world, RIGHT);
+  }
+
+  return world.creature?.carriedSince ?? -1;
+}
+
+describe('the startle', () => {
+  // The startle is a couple of ticks longer now and then; pin the dice to the short one.
+  beforeEach(() => {
+    vi.spyOn(Math, 'random').mockReturnValue(0);
+  });
+
+  it('ignores a jump on the last tick of the startle', () => {
+    const world = worldFrom(ROOM, { creature: true });
+    const since = mount(world);
+
+    run(world, hold({}, since + CREATURE_STARTLE_TICKS - 1 - world.tick));
+    run(world, hold({ jump: true }, 1));
+
+    expect(world.player.onGround).toBe(true);
+  });
+
+  it('answers a jump on the tick after the startle', () => {
+    const world = worldFrom(ROOM, { creature: true });
+    const since = mount(world);
+
+    run(world, hold({}, since + CREATURE_STARTLE_TICKS - world.tick));
+    run(world, hold({ jump: true }, 1));
+
+    expect(world.player.onGround).toBe(false);
+  });
+
+  it('lets him walk before the creature climbs on', () => {
+    const world = worldFrom(ROOM, { creature: true });
+    const x = world.player.x;
+
+    run(world, hold({ right: true }, 2));
+
+    expect(world.player.x).toBeGreaterThan(x);
+  });
+});
